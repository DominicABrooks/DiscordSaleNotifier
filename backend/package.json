{
  "name": "steamsaleswebhook",
  "version": "0.0.1",
  "description": "Pull from Steamworks api to post Discord webhooks to personal Discord when good sales happen",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "setup:dev": "cross-env NODE_ENV=development node dist/db/migrations/setup_db.js",
    "setup:test": "cross-env NODE_ENV=test node dist/db/migrations/setup_db.js",
    "dev": "cross-env NODE_ENV=development node dist/src/main.js",
    "test:server": "cross-env NODE_ENV=test node dist/src/main.js",
    "batch:test": "cross-env NODE_ENV=test STEAM_CRON=off node run-batch.mjs",
    "test:unit": "vitest run",
    "test:mutation": "stryker run",
    "test:fuzz": "cross-env FUZZ_RUNS=10000 STEAM_CRON=off vitest run fuzz --reporter=verbose"
  },
  "author": "Dominic Brooks",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cross-env": "^7.0.3",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "steamsaleswebhook": "file:",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1",
    "validator": "^13.12.0"
  },
  "keywords": [],
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/validator": "^13.12.0",
    "fast-check": "^4.10.0",
    "supertest": "^7.2.2",
    "typescript": "^5.5.2",
    "vitest": "^3.2.4"
  }
}
